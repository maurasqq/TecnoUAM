meta {
  name: Actualizar equipo
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/equipos/{{equipoCreadoId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "codigoPatrimonial": "PAT-100",
    "nombre": "Laptop Lenovo ThinkPad T14",
    "tipo": "LAPTOP"
  }
}

assert {
  res.status: eq 200
}
