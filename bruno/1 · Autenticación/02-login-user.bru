meta {
  name: Login USER
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "operador",
    "password": "{{userPassword}}"
  }
}

assert {
  res.status: eq 200
  res.body.role: eq USER
}

script:post-response {
  bru.setVar("tokenUser", res.body.token);
}
