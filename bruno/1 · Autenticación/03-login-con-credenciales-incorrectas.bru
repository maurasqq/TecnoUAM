meta {
  name: Login con credenciales incorrectas
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "admin",
    "password": "contrasena-incorrecta"
  }
}

assert {
  res.status: eq 401
}
