meta {
  name: Login ADMIN
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "admin",
    "password": "{{adminPassword}}"
  }
}

assert {
  res.status: eq 200
  res.body.role: eq ADMIN
}

script:post-response {
  bru.setVar("token", res.body.token);
}
