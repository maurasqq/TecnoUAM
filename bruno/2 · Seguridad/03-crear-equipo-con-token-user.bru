meta {
  name: Crear equipo con token USER
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/equipos
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{tokenUser}}
}

body:json {
  {
    "codigoPatrimonial": "PAT-900",
    "nombre": "Equipo no permitido",
    "tipo": "LAPTOP"
  }
}

assert {
  res.status: eq 403
}
